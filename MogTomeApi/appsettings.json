{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "DiscordLoginUri": "https://discord.com/oauth2/authorize",
    "DiscordTokenUri": "https://discord.com/api/oauth2/token",
    "Scopes": "identify",
    "AllowedRedirectHosts": "www.mogtome.com;mogtome.com;localhost",
    "DiscordTokenExpirationPaddingInSeconds": 300
  }
}
